# Copy to .env or export in your shell. All settings optional.

# tushare token (fallback data source). Get one at https://tushare.pro
# Without it, akshare still works for most things.
TUSHARE_TOKEN=

# Where the paper-trading account JSON is stored.
# Default: <repo>/data  (falls back to ~/.ashare-mcp if not writable)
# ASHARE_MCP_DATA_DIR=F:/Hermes/ashare-mcp/data
